{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nowhere:telemetry:3",
  "title": "Nowhere telemetry 3",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "hello"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "instance"
          ],
          "properties": {
            "instance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "telemetry_protocol",
                "id",
                "role",
                "pid",
                "version",
                "endpoint"
              ],
              "properties": {
                "telemetry_protocol": {
                  "const": "nowhere.telemetry.3"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "role": {
                  "enum": [
                    "portal",
                    "vector",
                    "egress"
                  ]
                },
                "pid": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                },
                "version": {
                  "type": "string"
                },
                "endpoint": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "data"
      ],
      "properties": {
        "type": {
          "const": "snapshot"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tcp_upload_bytes",
            "tcp_download_bytes",
            "udp_upload_bytes",
            "udp_download_bytes",
            "tcp_active",
            "udp_active"
          ],
          "properties": {
            "tcp_upload_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "tcp_download_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "udp_upload_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "udp_download_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "tcp_active": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            "udp_active": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            }
          }
        }
      }
    }
  ]
}
